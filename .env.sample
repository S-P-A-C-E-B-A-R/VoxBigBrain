# Copy this file to .env and replace all deployment placeholders. Never commit .env.

# LiveKit credentials. Generate a unique, long random secret for production.
LIVEKIT_API_KEY=voxbigbrain
LIVEKIT_API_SECRET=replace-with-a-long-random-secret

# Required authentication secrets. Generate each with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-session-secret
INTERNAL_AGENT_SECRET=replace-with-a-long-random-internal-agent-secret

# Public DNS names. TLS is terminated by an external reverse proxy.
PUBLIC_UI_HOST=voice.example.com
PUBLIC_RTC_HOST=rtc.example.com
PUBLIC_TURN_HOST=turn.example.com

# External services and models.
QWEN_BASE_URL=http://192.168.1.100:8080/v1
QWEN_API_KEY=local
QWEN_MODEL=qwen3.6-35b
KAGI_API_KEY=replace-me
WHISPER_MODEL=Systran/faster-whisper-small.en
WHISPER_COMPUTE_TYPE=int8
# The live WebSocket supports model, language, temperature, and vad_filter only.
WHISPER_STREAMING_ENABLED=true
WHISPER_WS_URL=ws://whisper:8000/v1/audio/transcriptions
WHISPER_LANGUAGE=en
WHISPER_TEMPERATURE=0.0
# Keep disabled by default: Silero remains the authoritative speech gate.
WHISPER_VAD_FILTER=false
# Upper bound (seconds) the adapter waits for the server's finalization flush.
WHISPER_WS_FINALIZATION_SECONDS=60
KOKORO_MODEL=kokoro
KOKORO_VOICE=af_heart
LOCAL_TIMEZONE=America/New_York

# Silero VAD gates non-speech before faster-whisper receives audio.
VAD_ACTIVATION_THRESHOLD=0.65
VAD_MIN_SPEECH_DURATION=0.20
VAD_MIN_SILENCE_DURATION=0.50
VAD_PREFIX_PADDING_DURATION=0.20

# Barge-in and false-interruption recovery.
INTERRUPTION_MIN_DURATION=0.50
INTERRUPTION_MIN_WORDS=1
FALSE_INTERRUPTION_TIMEOUT=0.80

# Authentication and chat retention. Authentication is mandatory in Compose.
AUTH_ENABLED=true
ALLOW_REGISTRATION=false
SESSION_TTL_HOURS=168
CHAT_CONTEXT_MAX_MESSAGES=50
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
MAX_ACTIVE_VOICE_SESSIONS_PER_USER=2
VOICE_SESSION_RATE_LIMIT_PER_MINUTE=10
VOICE_SESSION_TTL_MINUTES=10
